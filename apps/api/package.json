{
  "name": "@paadel/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@paadel/audit-log": "workspace:*",
    "@paadel/auth": "workspace:*",
    "@paadel/db": "workspace:*",
    "@paadel/domain": "workspace:*",
    "@paadel/env": "workspace:*",
    "@elysiajs/openapi": "^1.4.15",
    "elysia": "^1.4.29",
    "evlog": "^2.22.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@paadel/config": "workspace:*",
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2"
  }
}
