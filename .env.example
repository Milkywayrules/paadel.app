# Doppler is the source of truth for all values. This file lists key NAMES only.
# Key shape: packages/env/src/manifest.ts + Zod schema in packages/env
#
# Setup:    bun run doppler:setup
# Validate: bun run doppler:validate
# Dev:      bun run dev
#
# Optional — materialize gitignored .env for file-based tools:
#   doppler secrets download --no-file --format env > .env && chmod 600 .env
#
# Do not commit .env. Edit secrets in Doppler only.

# --- Required in every tier (dev | stg | prd) ---
# APP_ENV                      dev | stg | preview | prod
# API_CORS_ORIGIN              must equal NEXT_PUBLIC_APP_URL
# BETTER_AUTH_SECRET           min 32 chars
# BETTER_AUTH_URL              must equal NEXT_PUBLIC_API_URL
# EMAIL_FROM
# NEXT_PUBLIC_APP_URL
# NEXT_PUBLIC_API_URL
# OAUTH_GITHUB_CLIENT_ID
# OAUTH_GITHUB_CLIENT_SECRET
# RESEND_API_KEY
# R2_ACCOUNT_ID
# R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY
# R2_BUCKET_NAME
# R2_PREFIX                    must match APP_ENV: dev/ | stg/ | prod/
# POSTGRES_PASSWORD            deploy compose builds DB_URL from this

# --- Required in Doppler dev only (host dev; compose wires these at deploy) ---
# DB_URL
# REDIS_URL

# --- Optional ---
# NODE_ENV                     defaults to development
# OTEL_EXPORTER_OTLP_ENDPOINT  tracing opt-in per tier
