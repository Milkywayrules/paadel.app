# Runtime
NODE_ENV=development

# Database
DATABASE_URL=postgresql://paadel:paadel@localhost:5432/paadel

# Redis
REDIS_URL=redis://localhost:6379

# Auth (Better Auth — mounted on API)
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-long
BETTER_AUTH_URL=http://localhost:3001
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Web (Next.js public — copy to apps/web/.env.local for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Paadel <noreply@paadel.app>

# Object storage (Cloudflare R2 — MVP1-2 single bucket, env prefix)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bucket---paadel-app
R2_PREFIX=dev/

# OpenTelemetry (optional in dev)
OTEL_EXPORTER_OTLP_ENDPOINT=
