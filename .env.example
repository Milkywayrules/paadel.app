# Runtime
NODE_ENV=development
APP_ENV=dev

# Database
DB_URL=postgresql://paadel:paadel@localhost:5432/paadel

# Cache
REDIS_URL=redis://localhost:6379

# Auth (Better Auth — mounted on API)
BETTER_AUTH_SECRET=dev-secret-change-me-min-32-chars-long
BETTER_AUTH_URL=http://localhost:3001
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Set true to test GitHub login locally (off by default in APP_ENV=dev)
OAUTH_GITHUB_ENABLED=false

# Web (Next.js public — copy to apps/web/.env.local for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
# Show GitHub button on login (align with OAUTH_GITHUB_ENABLED for local dev)
NEXT_PUBLIC_OAUTH_GITHUB_ENABLED=false

# API server
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000

# Email
RESEND_API_KEY=
EMAIL_FROM=Paadel <noreply@paadel.app>

# Object storage (ADR 0003 — single bucket, env prefix)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bucket---paadel-app
R2_PREFIX=dev/

# OpenTelemetry (optional in dev)
OTEL_EXPORTER_OTLP_ENDPOINT=
