# Doppler is the source of truth for all values. This file lists key NAMES only.
# Key shape: packages/env/src/manifest.ts + Zod schema in packages/env
#
# Setup:    bun run doppler:setup
# Validate: bun run doppler:validate
# Dev:      bun run dev
#
# Optional — materialize gitignored .env for file-based tools:
#   doppler secrets download --no-file --format env > .env && chmod 600 .env
#
# Do not commit .env. Edit secrets in Doppler only.

# =============================================================================
# paadel.app — COMPLETE ENV / SECRET CATALOG (every key, every legal value)
# Source of truth: packages/env/src/server.ts + client.ts + manifest.ts
# Values live in Doppler. Configs: dev | stg | prd
# =============================================================================

# -----------------------------------------------------------------------------
# 1) TIER — enumerated, only these strings are valid
# -----------------------------------------------------------------------------
APP_ENV=dev                     # dev | stg | preview | prod
                                #   Doppler dev -> dev
                                #   Doppler stg -> stg
                                #   Doppler prd -> prod   (slug != value, intentional)
                                #   preview     -> legal in schema, no Doppler config

NODE_ENV=development            # development | test | production   (OPTIONAL, defaults development)
                                #   dev -> development ; stg/prd -> production
                                #   deploy compose hardcodes production on containers anyway

# -----------------------------------------------------------------------------
# 2) PUBLIC URLS — must be full URLs with scheme; two mirrored pairs
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://WEB_HOST     # web public address        (BUILD ARG for web image)
API_CORS_ORIGIN=https://WEB_HOST         # MUST equal NEXT_PUBLIC_APP_URL exactly

NEXT_PUBLIC_API_URL=https://API_HOST     # api public address        (BUILD ARG for web image)
BETTER_AUTH_URL=https://API_HOST         # MUST equal NEXT_PUBLIC_API_URL exactly

# -----------------------------------------------------------------------------
# 3) SECRETS — free-form strings; generate or copy from provider
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=              # min 32 chars   -> openssl rand -hex 32
POSTGRES_PASSWORD=               # non-empty      -> openssl rand -base64 24 | tr -d '/+='
                                 #   compose only (NOT in the Zod schema); builds DB_URL at deploy

OAUTH_GITHUB_CLIENT_ID=          # GitHub > Settings > Developer settings > OAuth Apps
OAUTH_GITHUB_CLIENT_SECRET=      # same OAuth app
                                 #   callback URL to register:
                                 #   https://API_HOST/api/auth/callback/github

EMAIL_FROM=Paadel <noreply@paadel.app>   # min 3 chars; domain must be verified in Resend
RESEND_API_KEY=                  # Resend dashboard > API Keys

R2_ACCOUNT_ID=                   # Cloudflare dashboard > R2 > account ID
R2_ACCESS_KEY_ID=                # Cloudflare R2 > Manage API Tokens
R2_SECRET_ACCESS_KEY=            # same token, shown once
R2_BUCKET_NAME=bucket---paadel-app       # one bucket for all tiers (ADR 0003)
R2_PREFIX=dev/                   # dev/ | stg/ | prod/
                                 #   MUST match APP_ENV or the API throws at startup:
                                 #   dev->dev/  stg->stg/  preview->stg/  prod->prod/

# -----------------------------------------------------------------------------
# 4) DEV-ONLY — required in Doppler dev, FORBIDDEN in stg/prd (validator rejects)
#    deploy compose wires both internally; never paste these into Coolify
# -----------------------------------------------------------------------------
DB_URL=postgresql://paadel:paadel@localhost:5432/paadel   # postgresql://user:pass@host:5432/db
REDIS_URL=redis://localhost:6379                          # redis://host:6379
#   at deploy: DB_URL=postgresql://paadel:${POSTGRES_PASSWORD}@postgres:5432/paadel
#              REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# 5) OPTIONAL — the only key allowed to be empty
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=     # empty | https://collector-host   (nothing reads it yet)

# -----------------------------------------------------------------------------
# 6) FORBIDDEN IN DOPPLER — bun run doppler:validate FAILS if any are present
# -----------------------------------------------------------------------------
# DOPPLER_TOKEN                  # service token; belongs in CI secrets / Coolify only
# ENV_SKIP_VALIDATION            # true | false — set by Dockerfile build + CI only
# CI                             # true | false — set by GitHub Actions only

# -----------------------------------------------------------------------------
# 7) DOPPLER-INJECTED — always present, cannot be deleted, do not manage
# -----------------------------------------------------------------------------
# DOPPLER_PROJECT=paadel-app
# DOPPLER_CONFIG=dev             # dev | dev_personal | stg | prd
# DOPPLER_ENVIRONMENT=dev        # dev | stg | prd

# =============================================================================
# COUNT PER DOPPLER CONFIG
#   dev  -> 18 required (16 tier + DB_URL + REDIS_URL) + 1 optional
#   stg  -> 16 required                                 + 1 optional
#   prd  -> 16 required                                 + 1 optional
# =============================================================================
