{
  "name": "paadel",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "doppler run -- turbo run dev",
    "lint": "biome check apps packages",
    "lint:fix": "biome check --write apps packages",
    "smoke": "bash scripts/smoke.sh",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "doppler run -- bun run --filter @paadel/db generate",
    "db:migrate": "doppler run -- bun run --filter @paadel/db migrate",
    "doppler:setup": "doppler setup",
    "doppler:validate": "bun scripts/doppler-validate.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@paadel/env": "workspace:*",
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^22.17.2",
    "lefthook": "^1.11.14",
    "turbo": "^2.5.4",
    "typescript": "^5.9.2",
    "ultracite": "^7.9.4"
  },
  "packageManager": "bun@1.3.14"
}
